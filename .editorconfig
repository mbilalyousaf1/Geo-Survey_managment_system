root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.md]
# Markdown uses trailing spaces for intentional hard line breaks.
trim_trailing_whitespace = false

[src/Backend/Modules/Identity/GeoSurvey.Identity.Infrastructure/PasswordBlocklistData/common-passwords.txt]
# Preserve the pinned third-party bytes, including meaningful whitespace and line endings.
charset = unset
trim_trailing_whitespace = false
insert_final_newline = unset
