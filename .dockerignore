# Only the API and its referenced production projects belong in this build context.
**
!global.json
!Directory.Build.props
!.editorconfig
!src/
!src/Backend/
!src/Backend/GeoSurvey.Api/
!src/Backend/GeoSurvey.Api/**
!src/Backend/GeoSurvey.ControlPlane.Infrastructure/
!src/Backend/GeoSurvey.ControlPlane.Infrastructure/**
!src/Backend/Modules/
!src/Backend/Modules/Identity/
!src/Backend/Modules/Identity/GeoSurvey.Identity.Infrastructure/
!src/Backend/Modules/Identity/GeoSurvey.Identity.Infrastructure/**
!src/Backend/Modules/Organizations/
